#!/bin/bash
# git pull sur tous les sites de démo, redémarre ALTinformatique si besoin
echo "=== Mise à jour des sites de démo ==="
for d in /var/www/demo/*/; do
  [ -d "$d/.git" ] || continue
  nom=$(basename "$d"); avant=$(git -C "$d" rev-parse HEAD)
  echo; echo "▶ $nom"
  if ! git -C "$d" pull --ff-only; then echo "  ⚠ échec de la mise à jour"; continue; fi
  apres=$(git -C "$d" rev-parse HEAD)
  if [ "$nom" = altinformatique ] && [ "$avant" != "$apres" ]; then
    if git -C "$d" diff --name-only "$avant" "$apres" | grep -q '^backend/package'; then
      echo "  Nouvelles dépendances : npm install"; (cd "$d/backend" && npm install --omit=dev)
    fi
    echo "  Redémarrage d'ALTinformatique…"
    systemctl restart altinformatique && echo "  ✔ redémarré"   # droit donné par polkit, sans sudo
  fi
done
echo; echo "Terminé."; if [ -t 0 ]; then read -rp "Appuie sur Entrée pour fermer…"; fi
