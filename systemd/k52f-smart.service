# Relevé SMART quotidien du SSD interne (root : smartctl en a besoin), en bac à sable strict.
[Unit]
Description=K52F : relevé SMART du SSD interne

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/k52f-smart-releve
StateDirectory=k52f-mesures
StateDirectoryMode=0755
UMask=0027
Nice=15
IOSchedulingClass=idle

# Bac à sable : pas de réseau, lecture seule partout sauf son dossier, accès disque en lecture.
PrivateNetwork=yes
IPAddressDeny=any
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=block-sd r
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
# smartctl interroge le disque par des commandes « brutes » : seules ces capacités restent.
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_SYS_ADMIN CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
